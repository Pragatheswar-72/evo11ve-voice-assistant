# required
GROQ_API_KEY=your_groq_api_key

# --- email: fill ONE of the two options (leave both empty to simulate emails) ---

# option 1: Brevo API (use this on Render)
BREVO_API_KEY=
SENDER_EMAIL=

# option 2: Gmail SMTP (local) - use an app password, not your normal password
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# where team alerts go (enrollment / callback / escalation)
TEAM_EMAIL=

# optional: lets you view leads at /leads?key=ADMIN_KEY
ADMIN_KEY=
